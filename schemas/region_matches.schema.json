{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region_matches.schema.json",
  "type": "object",
  "required": ["company", "records"],
  "properties": {
    "company": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "region_match"],
        "properties": {
          "record_id": {"type": "string"},
          "region_match": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["MATCHED", "REVIEW_REQUIRED"]},
              "country_id": {"type": ["string", "null"]},
              "province_id": {"type": ["string", "null"]},
              "city_id": {"type": ["string", "null"]},
              "area_id": {"type": ["string", "null"]},
              "reason": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
